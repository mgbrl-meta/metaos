{
  "version": "2026-07-10",
  "product": "MetaOS",
  "purpose": "Freeze every current production frontend module before the architecture-first redesign.",
  "routes": [
    {
      "path": "/",
      "file": "app/(legacy)/page.tsx",
      "role": "Current production workspace containing all retained Meta, Google and system modules."
    },
    {
      "path": "/v2",
      "file": "app/(legacy)/v2/page.tsx",
      "role": "Parallel V2 workspace containing protected engine-backed dashboards."
    },
    {
      "path": "/workspace",
      "file": "app/workspace/page.tsx",
      "role": "Parallel architecture-first MetaOS application shell."
    }
  ],
  "infrastructure": {
    "rootLayout": "app/layout.tsx",
    "legacyShell": "components/layout/MetaOSShell.tsx",
    "v2Shell": "components/meta-v2/shell/MetaOSV2App.tsx",
    "dataLoader": "components/meta/AutoMetaSheetLoader.tsx",
    "dataStore": "store/metaStore.ts",
    "themeProvider": "components/theme/ThemeProvider.tsx",
    "apiRoute": "app/api/meta-sheet/route.ts"
  },
  "modules": [
    {
      "platform": "meta",
      "id": "data_qc",
      "label": "Data QC",
      "component": "components/meta/DataQCTab.tsx",
      "pageToken": "activeMetaTab === \"data_qc\""
    },
    {
